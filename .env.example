# ==============================================================================
# PackGuard AI - Environment Configuration Template
# Copy this file to .env for local development:
#   copy .env.example .env (Windows)
#   cp .env.example .env   (Linux/macOS)
# On Render: Add these keys under Service -> Environment Variables
# ==============================================================================

# Gemini API Key (Required for live multimodal inspection & conversational follow-up)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Flask / Web Server Configuration
# Note: Render automatically provides $PORT at runtime
PORT=5000
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
FLASK_DEBUG=false

# Gunicorn Production WSGI Settings (Used on Render)
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
LOG_LEVEL=info
